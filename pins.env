# Immutable pins. Regenerate with tools/resolve-pins.sh, review the diff, commit.
# Every value here is a digest or a commit SHA: no tags that can move underneath us.

# CUDA 12.9.1. Blackwell (sm_120) needs >= 12.8; 12.9 is the newest that is not a
# major-version jump the custom-node ecosystem may not have followed yet.
BASE_DEVEL=nvidia/cuda@sha256:1cb02388491c05441f8963d42bc38b6ec5462fba95a8e3bb2cb8e6091f0738c8
BASE_RUNTIME=nvidia/cuda@sha256:bcf8f5037535884fffbde1c1584af29e9eccc3f432d1cb05a5216a1184af12d8

# Matching wheel channel. cu130 ships newer torch, but 12.9 keeps us one step
# behind the bleeding edge on purpose.
TORCH_CHANNEL=cu129
TORCH_VERSION=2.13.0

COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI
COMFYUI_SHA=12d5279438bfefc058a269eae805ceab6047777f
COMFYUI_RELEASE=v0.34.0
